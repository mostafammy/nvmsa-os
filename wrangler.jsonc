{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nvmsa-os",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "nvmsa.us/*",
      "zone_name": "nvmsa.us"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nvmsa-os-db",
      "database_id": "1271c546-fe90-410c-b716-070882d6b3f6",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_TIMEZONE": "Africa/Cairo"
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nvmsa-os-db-preview",
          "database_id": "307d995e-2a2b-43de-af5b-3bcfa00aa40e",
          "migrations_dir": "drizzle"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "APP_TIMEZONE": "Africa/Cairo"
      }
    }
  }
}
